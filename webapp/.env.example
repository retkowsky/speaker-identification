# Optional Azure defaults. Saved endpoint/index settings in the app take precedence.
# Clear the endpoint in the app to disable an already-saved cloud connection.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=speaker-identification
# Prefer Entra ID via DefaultAzureCredential (for example, az login).
# If using a key instead, set its service endpoint above and a Search admin key here.
# The app will not send this key to a different endpoint. Never commit .env.
AZURE_SEARCH_API_KEY=
